#!/usr/bin/env python3
from __future__ import annotations

import json
import os
import subprocess
import sys
from pathlib import Path


def _logs_root() -> Path:
    data_dir = Path(os.environ["CLAWTEAM_DATA_DIR"])
    root = data_dir / "smoke-logs"
    root.mkdir(parents=True, exist_ok=True)
    return root


def _append_invocation(record: dict[str, object]) -> None:
    path = _logs_root() / "openclaw-invocations.jsonl"
    with path.open("a", encoding="utf-8") as handle:
        handle.write(json.dumps(record, ensure_ascii=False) + "\n")


def _worker_script() -> Path:
    candidate = Path(__file__).resolve().with_name("fake_worker.py")
    if not candidate.exists():
        raise FileNotFoundError(f"fake worker not found next to openclaw shim: {candidate}")
    return candidate


def _parse_flag(argv: list[str], flag: str) -> str | None:
    try:
        index = argv.index(flag)
    except ValueError:
        return None
    if index + 1 >= len(argv):
        return None
    return argv[index + 1]


def _fail(record: dict[str, object], message: str) -> int:
    record["status"] = "error"
    record["error"] = message
    _append_invocation(record)
    print(message, file=sys.stderr)
    return 2


def main(argv: list[str]) -> int:
    record: dict[str, object] = {
        "argv": argv,
        "cwd": os.getcwd(),
        "agentName": os.environ.get("CLAWTEAM_AGENT_NAME"),
        "agentId": os.environ.get("CLAWTEAM_AGENT_ID"),
        "teamName": os.environ.get("CLAWTEAM_TEAM_NAME"),
        "workspaceDir": os.environ.get("CLAWTEAM_WORKSPACE_DIR"),
    }
    if not argv:
        return _fail(record, "fake openclaw smoke shim requires a mode: expected `tui`.")

    mode = argv[0]
    record["mode"] = mode
    if mode != "tui":
        return _fail(record, f"fake openclaw smoke shim only supports `tui`, got {mode!r}.")

    deliver_enabled = "--deliver" in argv
    session_id = _parse_flag(argv, "--session")
    message = _parse_flag(argv, "--message")
    record["deliver"] = deliver_enabled
    record["session"] = session_id
    record["message"] = message

    if not deliver_enabled:
        return _fail(record, "fake openclaw smoke shim requires `--deliver` for TUI delivery.")
    if not session_id:
        return _fail(record, "fake openclaw smoke shim requires `--session <session-id>`.")
    if not message:
        return _fail(record, "fake openclaw smoke shim requires `--message <prompt>`.")

    worker_command = [sys.executable, str(_worker_script()), "--prompt", message]
    record["workerCommand"] = worker_command
    print(f"fake openclaw smoke runtime start session={session_id}", flush=True)
    completed = subprocess.run(worker_command, env=os.environ.copy())
    record["workerExitCode"] = completed.returncode
    record["status"] = "ok" if completed.returncode == 0 else "worker_failed"
    _append_invocation(record)
    return completed.returncode


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
